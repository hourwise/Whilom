{
  "name": "@whilom/ingestion",
  "version": "0.0.0",
  "private": true,
  "description": "Governed data-ingestion pipeline: source adapters, normalise, validate, match/dedupe, enrich, review, publish (spec \u00a735). SERVER-ONLY.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "scale:capture": "tsx scale/capture.ts",
    "scale:run": "tsx scale/run-tier.ts",
    "scale:seed": "tsx scale/db-seed.ts",
    "scale:commons": "tsx scale/commons-throughput.ts"
  },
  "dependencies": {
    "@whilom/database": "workspace:*",
    "@whilom/domain": "workspace:*",
    "@whilom/validation": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
