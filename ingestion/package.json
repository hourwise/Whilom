{
  "name": "@whilom/ingestion",
  "version": "0.0.0",
  "private": true,
  "description": "Governed data-ingestion pipeline: source adapters, normalise, validate, match/dedupe, enrich, review, publish (spec \u00a735). SERVER-ONLY.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "scale:capture": "tsx scale/capture.ts",
    "scale:run": "tsx scale/run-tier.ts",
    "scale:seed": "tsx scale/db-seed.ts",
    "scale:commons": "tsx scale/commons-throughput.ts",
    "scale:equivalence": "tsx scale/equivalence.ts",
    "regional:capture": "tsx regional/capture.ts",
    "regional:activate": "tsx regional/activate.ts",
    "regional:people": "tsx regional/people.ts",
    "regional:temporal": "tsx regional/temporal-enrichment.ts",
    "regional:temporal-audit": "tsx regional/temporal-audit.ts",
    "regional:opportunity": "tsx regional/coverage-opportunity.ts",
    "national:audit": "tsx scale/national/audit.ts",
    "national:capture": "tsx scale/national/capture.ts",
    "national:ladder": "tsx scale/national/run-ladder.ts",
    "national:workload-audit": "tsx scale/national/workload-audit.ts"
  },
  "dependencies": {
    "@whilom/database": "workspace:*",
    "@whilom/domain": "workspace:*",
    "@whilom/validation": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
