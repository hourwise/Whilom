# =============================================================================
# Whilom — environment template
# Copy to `.env` (root) and per-app `.env.local` files. NEVER commit real values.
# =============================================================================

# --- Supabase (public — safe to expose to clients) -------------------------
# Web (Next.js) reads NEXT_PUBLIC_*, Mobile (Expo) reads EXPO_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional MapLibre style URL; the style must carry its own attribution.
NEXT_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (PRIVILEGED — server / ingestion ONLY, never in a client) ----
# Must not be referenced from apps/web client components or apps/mobile at all.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Ingestion source credentials (server-side only) -----------------------
# Add per-connector keys here as adapters are built, e.g.:
# HISTORIC_ENGLAND_API_KEY=
# WIKIDATA_USER_AGENT=whilom/0.0 (contact@example.com)
