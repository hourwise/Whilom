{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Whilom base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@whilom/domain": ["./packages/domain/src/index.ts"],
      "@whilom/database": ["./packages/database/src/index.ts"],
      "@whilom/validation": ["./packages/validation/src/index.ts"],
      "@whilom/search": ["./packages/search/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".expo"]
}
