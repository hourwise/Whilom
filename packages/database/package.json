{
  "name": "@heritage/database",
  "version": "0.0.0",
  "private": true,
  "description": "Shared database contracts: generated Supabase types + typed client factories. No app owns the schema.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/database.types.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@heritage/domain": "workspace:*",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "rimraf": "^6.0.1"
  }
}
