# Web app — copy to `.env.local`. Only NEXT_PUBLIC_* is exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional MapLibre style URL; the style must carry its own attribution.
NEXT_PUBLIC_MAP_STYLE_URL=

# Server-only (Route Handlers / Server Actions). NEVER prefix with NEXT_PUBLIC_.
# Not required by the current Web Supabase path; never expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
