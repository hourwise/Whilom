{
  "expo": {
    "name": "Whilom",
    "slug": "whilom",
    "scheme": "whilom",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.whilom.app"
    },
    "android": {
      "package": "uk.whilom.app"
    }
  }
}
