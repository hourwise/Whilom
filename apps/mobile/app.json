{
  "expo": {
    "name": "Heritage Companion",
    "slug": "heritage-companion",
    "scheme": "heritage",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
