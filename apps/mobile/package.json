{
  "name": "@whilom/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Whilom Mobile — location-aware heritage discovery while travelling (spec Part B).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"console.log('mobile lint is deferred on purpose - see docs/ARCHITECTURE.md')\"",
    "clean": "rimraf .expo .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@whilom/database": "workspace:*",
    "@whilom/domain": "workspace:*",
    "@whilom/search": "workspace:*",
    "@whilom/validation": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2"
  }
}
